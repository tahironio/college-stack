# Пути относительно каталога с docker-compose.yml.
# На Ubuntu удобно расположить проекты так:
# /opt/college/college-stack
# /opt/college/AIS/ais-college
# /opt/college/distantes
# /opt/college/schedule-app
AIS_PATH=../ais-college
DISTANTES_PATH=../distantes
SCHEDULE_PATH=../schedule-app

# Для локальной сети можно оставить college.local и добавить имена в DNS/hosts.
# Для интернета укажите реальный домен и направьте его DNS на белый IP.
DOMAIN=college.local

# Обязательные секреты — замените значения.
AIS_SECRET_KEY=replace-with-a-long-random-django-secret
DISTANTES_SESSION_SECRET=replace-with-a-long-random-session-secret
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
JWT_SECRET=replace-with-a-long-random-jwt-secret

# AIS
AIS_ALLOWED_HOSTS=ais.college.local,localhost,127.0.0.1
DPO_API_TOKEN=replace-with-dpo-api-token
AIS_GUNICORN_WORKERS=2

# Shedule PostgreSQL
POSTGRES_DB=schedule_db
POSTGRES_USER=schedule
CORS_ORIGIN=*

# Бэкапы Shedule
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
TZ=Europe/Moscow
